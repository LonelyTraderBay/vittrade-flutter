# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/run-artifacts/*
!flutter_app/run-artifacts/README.md
# page-rhythm-l3 là INPUT của artifact committed (screen-compliance CSV đọc
# evidence.csv khi rollup) — phải track để CI regen ra đúng nội dung.
!flutter_app/run-artifacts/page-rhythm-l3/
flutter_app/tmp/
flutter_app/*.log

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local linked worktrees (never commit gitlinks / machine paths)
.worktrees/

# Retired AI runtime — keep accidental legacy runtime output untracked
.claude/
CLAUDE.local.md
# Superpowers / SDD agent scratch (briefs, reports, review diffs) — never commit
.superpowers/

# Root-level scratch files
/tmp_*

# Python bytecode caches from local AI/tool scripts
__pycache__/
*.py[cod]

# Retired web tooling / generated artifacts
node_modules/
dist/
.vite/
output/
*.log

# AgentsRoom — machine-local MCP + caches (absolute paths; never commit)
.mcp.json
.agentsroom/

# Mimosa security-scan scratch (finding ledger, history, reports) — never commit
.mimosa/

# ZCode session artifacts (plan-mode files, session scratch) — never commit
.zcode/

# ZCode video-agent-kit plugin runtime marker — never commit
.video_agent/
